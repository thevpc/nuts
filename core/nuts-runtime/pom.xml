<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.thevpc.nuts</groupId>
        <artifactId>nuts-parent</artifactId>
        <version>1.2.0.0</version>
        <relativePath>../../parent/pom.xml</relativePath>
    </parent>
    <artifactId>nuts-runtime</artifactId>
    <version>1.2.0.0</version>
    <packaging>jar</packaging>
    <name>Nuts Community Core Runtime</name>
    <description>Nuts Reference Runtime Implementation</description>
    <properties>
        <nuts.runtime>true</nuts.runtime>
        <nuts.categories>
            /Settings/PackageManager/Nuts
        </nuts.categories>
        <nuts.icons>
            classpath://net/thevpc/nuts/runtime/nuts.svg
            classpath://net/thevpc/nuts/runtime/nuts.png
            classpath://net/thevpc/nuts/runtime/nuts.ico
        </nuts.icons>
        <nuts.windows-os-dependencies>
            org.fusesource.jansi:jansi
            com.github.vatbub:mslinks
        </nuts.windows-os-dependencies>
        <nuts.repositories>
            ~/.m2/repository
            https://repo.maven.apache.org/maven2/
        </nuts.repositories>
    </properties>
    <dependencies>
        <dependency><groupId>net.thevpc.nuts</groupId><artifactId>nuts</artifactId><version>1.2.0</version></dependency>
        <!-- force transitive dependencies-->
        <dependency><groupId>net.thevpc.nuts</groupId><artifactId>nuts-boot</artifactId><version>1.2.0</version></dependency>
        <dependency><groupId>org.fusesource.jansi</groupId><artifactId>jansi</artifactId><version>2.3.4</version><!--<optional>true</optional>--><!--!<os>windows</os>--></dependency>
        <dependency><groupId>com.github.vatbub</groupId><artifactId>mslinks</artifactId><version>1.0.5</version><!--<version>1.0.6.2</version> requires JDK10--><!--!<os>windows</os>--></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <!-- Compile module-info.java only on Java 9+ -->
                    <execution>
                        <id>compile-module-info</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <skip>${module-info.skip}</skip>
                            <release>9</release>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/java9</compileSourceRoot>
                            </compileSourceRoots>
                            <includes>
                                <include>module-info.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Multi-Release>true</Multi-Release>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <!-- explicit default repository for the runtime -->
        <repository><id>thevpc</id><url>https://maven.thevpc.net</url></repository>
    </repositories>
</project>
