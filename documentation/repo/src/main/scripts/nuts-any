#!/bin/bash
##     _   __      __
##    / | / /_  __/ /______
##   /  |/ / / / / __/ ___/
##  / /|  / /_/ / /_(__  )
## /_/ |_/\\__,_/\\__/____/  shell script
##
## do not edit this file, it will regenerated each time you call build-web-site
##
## this script is used in a nuts development environment only!
## it runs any nuts version available in the local maven repository
## ('~/.m2/repository/net/thevpc/nuts/nuts-app/<version>/nuts-app-<version>.jar'),
## so you need to call 'mvn install' (or have that version in ~/.m2) for it to work.
##
## usage: nuts-any <version> [--java-debug[=port,suspend,...]] [--java-options=<opts>] <nuts-args>...
##
## the version is mandatory and is never read from the environment
## (NUTS_VERSION is exported by the installed nuts and would silently win).
## use 'nuts-dev' for the current development version.
## In the case you are debugging an application called by nuts
## you can simply call 'nuts ---jdb your-application' (Please note the 3 dashes preceding jdb)
##

usage() {
    echo "usage: $(basename "$0") <version> [--java-debug[=...]] [--java-options=<opts>] <nuts-args>..." >&2
    echo "available versions in ~/.m2:" >&2
    ls ~/.m2/repository/net/thevpc/nuts/nuts-app/ 2>/dev/null | grep -E '^[0-9]' | sed 's/^/    /' >&2
}

if [ $# -eq 0 ] || [ -z "$1" ]; then
    echo "$(basename "$0"): missing nuts version" >&2
    usage
    exit 1
fi
case "$1" in
    -*)
        echo "$(basename "$0"): first argument must be a nuts version, got '$1'" >&2
        usage
        exit 1
        ;;
esac
NUTS_VERSION="$1"
shift

NUTS_APP_JAR=~/.m2/repository/net/thevpc/nuts/nuts-app/$NUTS_VERSION/nuts-app-$NUTS_VERSION.jar
if [ ! -f "$NUTS_APP_JAR" ]; then
    echo "$(basename "$0"): jar not found: $NUTS_APP_JAR" >&2
    usage
    exit 1
fi

# Define the JAVA_HOME if not already defined
if [ -z "$NUTS_JAVA_HOME" ]; then
    NUTS_JAVA_HOME="${JAVA8_HOME}"
fi

# Initialize variables for debugging options
NUTS_DEBUG_ARG=""
d_port=5005
d_enable="false"
d_suspend="n"

# Initialize variables for Java options
JAVA_OPTS=""

# Parse command line arguments for both debugging and Java options
while (( "$#" )); do
    case "$1" in
        --java-debug=*)
            sub=${1#*=}
            IFS=',' read -ra subArray <<< "$sub"
            for curr in "${subArray[@]}"; do
                case $curr in
                    [0-9]*) d_port=$curr ;;
                    no) d_enable="false" ;;
                    suspend) d_suspend="y" ;;
                    '!suspend') d_suspend="n" ;;
                    s) d_suspend="y" ;;
                    '!s') d_suspend="n" ;;
                    *) echo "$curr is unsupported" ;;
                esac
            done
            if [ "$d_enable" = "true" ]; then
                NUTS_DEBUG_ARG="-agentlib:jdwp=transport=dt_socket,server=y,suspend=$d_suspend,address=$d_port"
            fi
            shift
            ;;
        --java-options=*)
            JAVA_OPTS=${1#*=}
            shift
            ;;
        --java-debug)
            NUTS_DEBUG_ARG="-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=5005"
            shift
            ;;
        --java-options)
            echo "Usage: $0 <version> --java-options=<options>"
            exit 1
            ;;
        *)
            # first non-option token is the actual nuts command:
            # stop parsing launcher options and leave it (and everything
            # after it) intact in "$@" for the final invocation
            break
            ;;
    esac
done

# Determine the Java command to use
JAVA_CMD="java"
if [ -n "$NUTS_JAVA_HOME" ]; then
    JAVA_CMD="$NUTS_JAVA_HOME/bin/java"
elif [ -n "${JAVA_HOME}" ]; then
    JAVA_CMD="${JAVA_HOME}/bin/java"
fi

# Execute the Java application with debugging options and arguments
exec $JAVA_CMD $JAVA_OPTS $NUTS_DEBUG_ARG -jar "$NUTS_APP_JAR" -w development "$@"
